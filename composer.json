{
    "name": "klxm/dav",
    "description": "DAV-Server für REDAXO: Anmeldung, App-Passwörter und Einstiegspunkt für CalDAV, CardDAV und WebDAV aus anderen Addons",
    "type": "redaxo-addon",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "sabre/dav": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "KLXM\\Dav\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KLXM\\Dav\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
